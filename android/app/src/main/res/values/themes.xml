<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FixedSource" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_teal</item>
        <item name="colorOnPrimary">@color/brand_ink</item>
        <item name="colorPrimaryContainer">@color/teal_soft</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/brand_teal_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/brand_ink</item>
        <item name="android:navigationBarColor">@color/brand_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.FixedSource.Button</item>
        <item name="textInputStyle">@style/Widget.FixedSource.TextInput</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Widget.FixedSource.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/brand_teal</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.FixedSource.Button.Secondary" parent="Widget.FixedSource.Button">
        <item name="backgroundTint">@color/teal_soft</item>
        <item name="android:textColor">@color/brand_teal_dark</item>
        <item name="strokeColor">@color/brand_teal_dark</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.FixedSource.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.FixedSource.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/line</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="boxBackgroundColor">@color/card</item>
    </style>

    <style name="Widget.FixedSource.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="android:textSize">12sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">34dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="TextAppearance.FixedSource.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.FixedSource.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
